---
import type { BookLayout } from "../domain";
import { env } from "cloudflare:workers";
import { authenticatedUser } from "../lib/api";
import type { Env } from "../env";

export const prerender = false;
const user = authenticatedUser(Astro.locals);
const url = new URL(Astro.request.url);
const search = (url.searchParams.get("q") ?? "").trim().slice(0, 100);
const filter = url.searchParams.get("status") === "archived" ? "archived" : "active";
let books: Array<{ id: string; title: string; summary: string; stage: string; updatedAt: string; layout: BookLayout }> = [];

if (user?.id) {
  const result = await (env as Env).DB.prepare(
    `SELECT id, title, summary, stage, updated_at, layout_json FROM books
     WHERE owner_id = ? AND ${filter === "active" ? "archived_at IS NULL" : "archived_at IS NOT NULL"}
       AND instr(lower(title), lower(?)) > 0
     ORDER BY updated_at DESC, id DESC LIMIT 25`,
  ).bind(user.id, search).all<Record<string, unknown>>();
  books = result.results.map((row) => ({
    id: String(row.id), title: String(row.title), summary: String(row.summary),
    stage: String(row.stage), updatedAt: String(row.updated_at),
    layout: JSON.parse(String(row.layout_json)) as BookLayout,
  }));
}

const stageLabel: Record<string, string> = {
  blueprint: "Blueprint",
  outline: "Outline",
  manuscript: "Naskah",
  preview: "Preview",
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f0" />
    <title>Arenka Writer</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#23251f;background:#f7f5f0;font-synthesis:none;text-rendering:optimizeLegibility}
      *{box-sizing:border-box}body{margin:0;min-height:100vh}.shell{min-height:100vh;display:grid;grid-template-columns:248px minmax(0,1fr)}
      aside{padding:30px 20px;border-right:1px solid #e7e4dc;background:#fbfaf7;display:flex;flex-direction:column;gap:34px}.brand{display:flex;align-items:center;gap:11px;color:inherit;text-decoration:none;font-weight:750;letter-spacing:-.04em;font-size:20px}.mark{width:32px;height:32px;border-radius:11px;background:#294b3b;color:#f7f5f0;display:grid;place-items:center;font-family:Georgia,serif;font-size:19px}
      nav{display:grid;gap:7px}nav a{padding:11px 13px;border-radius:10px;color:#686b64;text-decoration:none;font-size:14px;font-weight:550}nav a[aria-current=page]{color:#294b3b;background:#e9eee8}nav a:hover{background:#efeee9;color:#292c26}.side-note{margin-top:auto;color:#8a8b83;font-size:12px;line-height:1.6}
      main{width:min(1120px,100%);margin:0 auto;padding:44px clamp(22px,5vw,70px) 72px}.top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:44px}.eyebrow{color:#77796f;font-size:12px;font-weight:650;letter-spacing:.09em;text-transform:uppercase}.welcome{font-size:14px;color:#6c6e67}.welcome strong{color:#34362f;font-weight:600}
      h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(34px,5vw,48px);font-weight:500;letter-spacing:-.045em;line-height:1.08;margin:10px 0 12px}.intro{color:#71736c;font-size:15px;line-height:1.6;margin:0}.heading{display:flex;justify-content:space-between;align-items:end;gap:16px;margin:42px 0 18px}.heading h2{font-family:Georgia,serif;font-size:25px;font-weight:500;letter-spacing:-.025em;margin:0 0 5px}.muted{font-size:13px;color:#85867e}
      .button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border-radius:10px;background:#294b3b;color:white;text-decoration:none;border:0;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer}.button:hover{background:#203d30}.button.secondary{background:#fff;border:1px solid #e2e0d8;color:#34362f}.button.secondary:hover{background:#f1f0eb}.actions{display:flex;gap:10px;flex-wrap:wrap}
      .filters{display:flex;gap:7px;border-bottom:1px solid #e6e3dc;margin-bottom:18px}.filters a{padding:10px 13px;color:#76786f;text-decoration:none;font-size:13px;border-bottom:2px solid transparent}.filters a.active{color:#294b3b;border-color:#496f58;font-weight:650}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.search{display:flex;gap:8px;max-width:440px;margin-bottom:20px}.search input{min-width:0;flex:1;height:42px;padding:0 13px;border:1px solid #e2e0d8;border-radius:9px;background:#fff;color:#292c26;font:inherit;font-size:13px}.search input:focus{outline:3px solid #dce8dc;border-color:#719078}
      .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.card{position:relative;min-height:180px;padding:18px 21px;border:1px solid #e7e4dc;border-radius:14px;background:#fff;display:flex;flex-direction:column;transition:border-color .15s,transform .15s}.card:hover{border-color:#b8c8b7;transform:translateY(-2px)}.card-link{display:flex;flex:1;flex-direction:column;color:inherit;text-decoration:none}.card-actions{display:flex;align-items:center;gap:11px;flex-wrap:wrap;border-top:1px solid #efeee9;margin-top:14px;padding-top:11px}.card-actions a,.archive-book{border:0;background:transparent;padding:2px 0;color:#506653;font:600 11px inherit;text-decoration:none;cursor:pointer}.archive-book{color:#825a50}.archive-book:disabled{opacity:.5;cursor:wait}.card-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.pill{font-size:11px;color:#49624e;background:#edf2eb;padding:6px 9px;border-radius:999px}.card h3{font-family:Georgia,serif;font-weight:500;font-size:21px;letter-spacing:-.02em;margin:17px 0 6px}.summary{font-size:13px;color:#77796f;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.date{font-size:11px;color:#96978f;margin-top:auto;padding-top:20px}
      .empty{border:1px dashed #d8d6cd;background:#fbfaf7;border-radius:14px;padding:38px 24px;text-align:center}.empty h3{font-family:Georgia,serif;font-size:23px;font-weight:500;margin:0 0 8px}.empty p{max-width:420px;margin:0 auto 20px;color:#77796f;font-size:13px;line-height:1.6}.login{margin:60px auto;max-width:480px;text-align:center;padding:40px 24px;border:1px solid #e7e4dc;background:white;border-radius:16px}.login p{color:#77796f;line-height:1.6;margin-bottom:22px}
      @media(max-width:760px){.shell{grid-template-columns:1fr}aside{position:sticky;top:0;z-index:2;padding:12px 17px;border-right:0;border-bottom:1px solid #e7e4dc;flex-direction:row;align-items:center;justify-content:space-between;gap:12px}.brand{font-size:18px}.mark{width:29px;height:29px}nav{display:flex;gap:2px}nav a{font-size:12px;padding:9px 10px}.side-note{display:none}main{padding:30px 18px 48px}.top{margin-bottom:34px}.grid{grid-template-columns:1fr}.heading{align-items:start;flex-direction:column}.actions{width:100%}.actions .button{flex:1}.welcome{font-size:12px}}
      @media(max-width:420px){aside{align-items:flex-start;flex-direction:column}.top{align-items:start;flex-direction:column}.welcome{display:none}nav{width:100%;justify-content:space-between}nav a{padding:8px 9px}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
    </style>
  </head>
  <body>
    <div class="shell">
      <aside>
        <a class="brand" href="/" aria-label="Arenka Writer, beranda"><span class="mark" aria-hidden="true">A</span><span>Arenka Writer</span></a>
        <nav aria-label="Navigasi utama">
          <a href="/" aria-current="page">Beranda</a>
          <a href="/?status=active#books">Buku</a>
          <a href="/voices">Profil Suara</a>
          <a href="/_emdash/admin">CMS</a>
        </nav>
        <p class="side-note">Ruang kerja untuk menyusun buku, satu bagian demi satu bagian.</p>
      </aside>
      <main>
        <div class="top"><span class="eyebrow">Ruang menulis Anda</span>{user && <span class="welcome">Masuk sebagai <strong>{user.email}</strong></span>}</div>
        <h1>Tuliskan buku<br />yang ingin Anda baca.</h1>
        <p class="intro">Ruang tenang untuk mengembangkan gagasan menjadi naskah.</p>

        {!user ? (
          <section class="login" aria-labelledby="login-title">
            <h2 id="login-title" style="font-family:Georgia,serif;font-weight:500">Masuk untuk membuka workspace</h2>
            <p>Gunakan akun Arenka untuk melihat dan melanjutkan buku Anda.</p>
            <a class="button" href="/_emdash/admin">Masuk atau siapkan akun</a>
          </section>
        ) : (
          <section id="books" aria-labelledby="books-title">
            <div class="heading">
              <div><h2 id="books-title">Buku Anda</h2><span class="muted">{books.length} buku ditampilkan</span></div>
              <div class="actions"><a class="button" href="/books/new">Buat buku</a></div>
            </div>
            <div class="filters" aria-label="Filter buku">
              <a href="/?status=active#books" class={filter === "active" ? "active" : ""} aria-current={filter === "active" ? "page" : undefined}>Aktif</a>
              <a href="/?status=archived#books" class={filter === "archived" ? "active" : ""} aria-current={filter === "archived" ? "page" : undefined}>Arsip</a>
            </div>
            <form class="search" method="get" action="/">
              <input type="hidden" name="status" value={filter} />
              <label class="sr-only" for="book-search">Cari judul buku</label>
              <input id="book-search" name="q" value={search} placeholder="Cari judul buku" />
              <button class="button secondary" type="submit">Cari</button>
            </form>
            {books.length ? (
              <div class="grid">
                {books.map((book) => (
                  <article class="card">
                  <a class="card-link" href={`/books/${book.id}`}>
                    <div class="card-top"><span class="eyebrow">{book.layout.pageSize} · {book.layout.orientation === "portrait" ? "Potret" : "Lanskap"}</span><span class="pill">{stageLabel[book.stage] ?? "Draft"}</span></div>
                    <h3>{book.title}</h3>
                    <span class="summary">{book.summary || "Belum ada ringkasan."}</span>
                    <span class="date">Diperbarui {new Date(book.updatedAt).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" })}</span>
                  </a>
                  <div class="card-actions"><a href={`/books/new?bookId=${book.id}&step=2`}>Blueprint</a><a href={`/books/${book.id}/outline`}>Outline</a><a href={`/books/${book.id}/preview`}>Preview</a><button type="button" class="archive-book" data-book-id={book.id} data-archived={filter === "archived"}>{filter === "archived" ? "Pulihkan" : "Arsipkan"}</button></div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty"><h3>{search ? "Judul belum ditemukan" : filter === "archived" ? "Belum ada buku di arsip" : "Mulai dengan sebuah gagasan"}</h3><p>{search ? "Coba kata pencarian lain atau hapus pencarian untuk melihat koleksi." : filter === "archived" ? "Buku yang Anda arsipkan akan muncul di sini." : "Buat ruang untuk gagasan Anda. Blueprint dapat disimpan dan dilanjutkan kapan saja."}</p>{!search && filter === "active" && <a class="button" href="/books/new">Buat buku pertama</a>}</div>
            )}
          </section>
        )}
      </main>
    </div>
    <script>
      document.querySelectorAll<HTMLButtonElement>(".archive-book").forEach((button) => button.addEventListener("click", async () => {
        const archived = button.dataset.archived !== "true";
        const action = archived ? "Arsipkan" : "Pulihkan";
        if (!window.confirm(`${action} buku ini? Isinya tetap tersimpan dan dapat dipulihkan.`)) return;
        button.disabled = true;
        try {
          const response = await fetch(`/api/books/${button.dataset.bookId}/archive`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ archived }) });
          if (!response.ok) throw new Error();
          window.location.reload();
        } catch {
          button.disabled = false;
          window.alert(`${action} belum berhasil. Coba lagi.`);
        }
      }));
    </script>
  </body>
</html>



