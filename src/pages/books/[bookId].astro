---
import { env } from "cloudflare:workers";
import { authenticatedOwner } from "../../lib/api";
import type { Env } from "../../env";

export const prerender = false;
const ownerId = authenticatedOwner(Astro.locals);
if (!ownerId) return Astro.redirect("/_emdash/admin");
const bookId = Astro.params.bookId ?? "";
const db = (env as Env).DB;
const book = await db.prepare(
  `SELECT id, title, summary, kind, stage FROM books WHERE id = ? AND owner_id = ? LIMIT 1`,
).bind(bookId, ownerId).first<{ id: string; title: string; summary: string; kind: string; stage: string }>();
if (!book) return Astro.redirect("/");
const chapterRows = await db.prepare(
  `SELECT c.id, c.position, c.title, c.purpose, c.approval_status,
    c.current_revision_id, r.content, r.revision_number
   FROM chapters c LEFT JOIN chapter_revisions r
     ON r.id = c.current_revision_id AND r.chapter_id = c.id AND r.owner_id = c.owner_id
   WHERE c.book_id = ? AND c.owner_id = ? ORDER BY c.position`,
).bind(bookId, ownerId).all<{ id: string; position: number; title: string; purpose: string; approval_status: string; current_revision_id: string | null; content: string | null; revision_number: number | null }>();
const chapters = chapterRows.results;
const initial = chapters[0];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{book.title} · Arenka Writer</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#242720;background:#f7f5f0}*{box-sizing:border-box}body{margin:0}.bar{height:62px;padding:0 22px;border-bottom:1px solid #e6e3dc;background:#fbfaf7;display:flex;align-items:center;gap:20px}.back{color:#526b57;text-decoration:none;font-size:13px}.title{font:500 19px Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stage{margin-left:auto;color:#536b58;background:#edf2eb;padding:7px 10px;border-radius:999px;font-size:11px}.workspace{min-height:calc(100vh - 62px);display:grid;grid-template-columns:260px minmax(0,1fr)}.outline{padding:23px 15px;border-right:1px solid #e6e3dc;background:#fbfaf7}.caption{color:#898a81;text-transform:uppercase;letter-spacing:.08em;font-weight:650;font-size:11px;margin:4px 9px 15px}.chapter-row{display:flex;align-items:center;gap:3px}.chapter{min-width:0;flex:1;border:0;background:transparent;text-align:left;padding:12px 11px;border-radius:9px;color:#62645d;cursor:pointer;font:inherit;font-size:13px;display:flex;gap:10px;align-items:center}.chapter:hover{background:#f0efe9}.chapter[aria-current=true]{background:#e9eee8;color:#294b3b}.number{font-size:11px;color:#92938b;min-width:17px}.move-chapter{width:29px;height:29px;border:1px solid transparent;border-radius:7px;background:transparent;color:#626b60;font-size:14px;cursor:pointer}.move-chapter:hover:not(:disabled){background:#eceee8;border-color:#dfe3da}.move-chapter:disabled{opacity:.3;cursor:default}.new-chapter{margin:12px 9px;border:1px solid #dfded6;background:white;color:#4a604d;border-radius:8px;padding:9px 12px;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer}.editor{width:min(900px,100%);margin:0 auto;padding:38px clamp(20px,5vw,64px) 80px}.context{color:#8b8c84;font-size:12px;margin-bottom:11px}.editor h1{font:500 clamp(29px,4vw,38px) Georgia,serif;letter-spacing:-.035em;margin:0 0 24px}.editor textarea{width:100%;min-height:55vh;padding:20px;border:1px solid #e4e1d9;border-radius:12px;background:#fff;color:#34362f;font:17px/1.8 Georgia,serif;resize:vertical;outline-color:#819782}.save-row{display:flex;align-items:center;gap:12px;margin-top:13px}.save{border:0;border-radius:9px;background:#294b3b;color:#fff;padding:11px 16px;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer}.save:disabled{opacity:.55}.history-button{border:1px solid #dfded6;border-radius:9px;background:#fff;color:#435c47;padding:10px 13px;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer}.history-button:hover{background:#f1f2ed}.status{font-size:12px;color:#7b7d74}.revision-dialog{width:min(720px,100%);max-height:min(84vh,760px);overflow:auto}.revision-dialog h2{margin-bottom:8px}.revision-list{display:grid;gap:7px;max-height:240px;overflow:auto}.revision-item{width:100%;display:flex;justify-content:space-between;gap:10px;text-align:left;padding:11px 12px;border:1px solid #e4e2da;border-radius:9px;background:#fff;color:#30332d;font-family:inherit;cursor:pointer}.revision-item:hover,.revision-item[aria-pressed=true]{border-color:#94a994;background:#f4f6f2}.revision-meta{color:#85877e;font-size:11px;white-space:nowrap}.revision-preview{margin-top:16px;padding:15px;border:1px solid #e5e3dc;border-radius:10px;background:#faf9f6}.revision-preview h3{margin:0 0 10px;font:500 17px Georgia,serif}.revision-preview pre{max-height:210px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.6 Georgia,serif;color:#55574f}.revision-preview[hidden]{display:none}.revision-dialog .dialog-actions{position:sticky;bottom:-22px;padding:12px 0 0;background:#fff}.empty{max-width:540px;margin:17vh auto;text-align:center}.empty h1{font:500 30px Georgia,serif}.empty p{color:#77796f;line-height:1.6;font-size:13px}.modal{position:fixed;inset:0;background:#20251c66;display:grid;place-items:center;padding:20px}.modal[hidden]{display:none}.dialog{width:min(440px,100%);background:white;border-radius:14px;padding:22px}.dialog h2{font:500 23px Georgia,serif;margin:0 0 18px}.dialog label{display:block;font-size:12px;font-weight:600;margin:13px 0 6px}.dialog input,.dialog textarea{width:100%;padding:11px;border:1px solid #deddd5;border-radius:8px;font:inherit}.dialog textarea{resize:vertical}.dialog-actions{display:flex;justify-content:end;gap:8px;margin-top:18px}.cancel,.confirm{border:0;border-radius:8px;padding:10px 13px;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer}.cancel{background:#f0efe9;color:#4c4e48}.confirm{background:#294b3b;color:white}.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:720px){.workspace{grid-template-columns:1fr}.outline{border-right:0;border-bottom:1px solid #e6e3dc;padding:12px;display:flex;overflow:auto;gap:4px}.caption{display:none}.chapter-row{flex:0 0 auto}.chapter{width:auto;white-space:nowrap}.move-chapter{flex:0 0 27px}.new-chapter{white-space:nowrap;margin:4px}.editor{padding:28px 16px}.editor textarea{min-height:48vh}}
    </style>
  </head>
  <body data-book-id={bookId}>
    <header class="bar"><a class="back" href="/">← Buku</a><span class="title">{book.title}</span><span class="stage">{book.stage === "blueprint" ? "Blueprint" : book.stage}</span></header>
    <div class="workspace">
      <aside class="outline" aria-label="Daftar bab">
        <p class="caption">Naskah</p>
        {chapters.map((chapter, index) => <div class="chapter-row"><button class="chapter" type="button" data-id={chapter.id} data-title={chapter.title} data-content={chapter.content ?? ""} data-current-revision-id={chapter.current_revision_id ?? ""} data-revision-number={chapter.revision_number ?? ""} aria-current={index === 0 ? "true" : "false"}><span class="number">{String(index + 1).padStart(2,"0")}</span>{chapter.title}</button><button class="move-chapter" type="button" data-id={chapter.id} data-direction="up" aria-label={`Pindahkan ${chapter.title} ke atas`} disabled={index === 0}>↑</button><button class="move-chapter" type="button" data-id={chapter.id} data-direction="down" aria-label={`Pindahkan ${chapter.title} ke bawah`} disabled={index === chapters.length - 1}>↓</button></div>)}
        <button class="new-chapter" id="new-chapter" type="button">＋ Bab baru</button>
      </aside>
      <main class="editor">
        {initial ? (
          <>
            <p class="context">{book.kind === "fiction" ? "Fiksi" : "Nonfiksi"} · Simpan revisi kapan saja</p>
            <h1 id="chapter-title">{initial.title}</h1>
            <label class="sr" for="chapter-content">Isi bab</label>
            <textarea id="chapter-content" placeholder="Mulai tulis draf bab Anda di sini…">{initial.content ?? ""}</textarea>
            <div class="save-row"><button class="save" id="save" type="button">Simpan revisi</button><button class="history-button" id="show-history" type="button">Riwayat revisi</button><span class="status" id="status" role="status" aria-live="polite">Perubahan tersimpan pada revisi terakhir.</span></div>
          </>
        ) : (
          <section class="empty"><p class="context">BLUEPRINT · {book.kind === "fiction" ? "FIKSI" : "NONFIKSI"}</p><h1>Susun kerangka naskah.</h1><p>Tambahkan bab untuk mulai menulis. Setiap penyimpanan membuat revisi baru agar perubahan dapat ditinjau.</p><button class="save" id="first-chapter" type="button">Buat bab pertama</button></section>
        )}
      </main>
    </div>
    <div class="modal" id="chapter-modal" hidden>
      <form class="dialog" id="chapter-form">
        <h2>Bab baru</h2>
        <label for="new-title">Judul bab</label><input id="new-title" maxlength="200" required placeholder="Contoh: Ketika semuanya berubah" />
        <label for="new-purpose">Tujuan bab <span style="font-weight:400;color:#85867e">(opsional)</span></label><textarea id="new-purpose" maxlength="2000" rows="3" placeholder="Apa yang perlu terjadi pada bagian ini?"></textarea>
        <p class="status" id="chapter-error" role="status" aria-live="polite"></p>
        <div class="dialog-actions"><button class="cancel" id="cancel" type="button">Batal</button><button class="confirm" type="submit">Buat bab</button></div>
      </form>
    </div>
    <div class="modal" id="revision-modal" hidden>
      <section class="dialog revision-dialog" role="dialog" aria-modal="true" aria-labelledby="revision-heading">
        <h2 id="revision-heading">Riwayat revisi</h2>
        <p class="status" id="revision-status" role="status" aria-live="polite">Memuat riwayat…</p>
        <div class="revision-list" id="revision-list"></div>
        <section class="revision-preview" id="revision-preview" hidden>
          <h3 id="revision-preview-heading"></h3>
          <pre id="revision-content"></pre>
          <button class="confirm" id="restore-revision" type="button">Pulihkan sebagai revisi baru</button>
        </section>
        <div class="dialog-actions"><button class="cancel" id="close-history" type="button">Tutup</button></div>
      </section>
    </div>
    <script>
      const bookId = document.body.dataset.bookId;
      const api = `/api/books/${bookId}`;
      const title = document.querySelector<HTMLElement>("#chapter-title");
      const content = document.querySelector<HTMLTextAreaElement>("#chapter-content");
      const selectedAtLoad = document.querySelector<HTMLButtonElement>('.chapter[aria-current="true"]');
      let activeId = selectedAtLoad?.dataset.id;
      let activeRevisionId = selectedAtLoad?.dataset.currentRevisionId || null;
      let savedContent = content?.value ?? "";
      const modal = document.querySelector<HTMLElement>("#chapter-modal")!;
      const form = document.querySelector<HTMLFormElement>("#chapter-form")!;
      const error = document.querySelector<HTMLElement>("#chapter-error")!;
      const historyModal = document.querySelector<HTMLElement>("#revision-modal")!;
      const historyList = document.querySelector<HTMLElement>("#revision-list")!;
      const historyStatus = document.querySelector<HTMLElement>("#revision-status")!;
      const preview = document.querySelector<HTMLElement>("#revision-preview")!;
      const previewHeading = document.querySelector<HTMLElement>("#revision-preview-heading")!;
      const previewContent = document.querySelector<HTMLElement>("#revision-content")!;
      let inspectedRevisionId: string | null = null;
      function selectChapter(button: HTMLButtonElement) {
        if (content && content.value !== savedContent && !window.confirm("Perubahan pada bab ini belum disimpan. Tinggalkan perubahan tersebut?")) return;
        document.querySelectorAll<HTMLButtonElement>(".chapter").forEach((item) => item.setAttribute("aria-current", "false"));
        button.setAttribute("aria-current", "true");
        activeId = button.dataset.id;
        activeRevisionId = button.dataset.currentRevisionId || null;
        if (title) title.textContent = button.dataset.title ?? "Bab";
        if (content) { content.value = button.dataset.content ?? ""; savedContent = content.value; }
        const status = document.querySelector<HTMLElement>("#status");
        if (status) status.textContent = button.dataset.revisionNumber ? `Revisi ${button.dataset.revisionNumber} tersimpan.` : "Belum ada revisi tersimpan.";
      }
      document.querySelectorAll<HTMLButtonElement>(".chapter").forEach((button) => button.addEventListener("click", () => selectChapter(button)));
      document.querySelectorAll<HTMLButtonElement>(".move-chapter").forEach((button) => button.addEventListener("click", async () => {
        if (content && content.value !== savedContent && !window.confirm("Perubahan belum disimpan. Tinggalkan perubahan sebelum mengubah urutan bab?")) return;
        const rows = [...document.querySelectorAll<HTMLButtonElement>(".chapter")];
        const originalIds = rows.map((row) => row.dataset.id).filter((id): id is string => Boolean(id));
        const ids = [...originalIds];
        const index = ids.indexOf(button.dataset.id ?? "");
        const target = index + (button.dataset.direction === "up" ? -1 : 1);
        if (index < 0 || target < 0 || target >= ids.length) return;
        [ids[index], ids[target]] = [ids[target], ids[index]];
        document.querySelectorAll<HTMLButtonElement>(".move-chapter").forEach((control) => { control.disabled = true; });
        const status = document.querySelector<HTMLElement>("#status");
        if (status) status.textContent = "Menyimpan urutan bab…";
        try {
          const response = await fetch(`${api}/chapters/order`, {
            method: "PUT", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ chapterIds: ids }),
          });
          if (response.status === 409) throw new Error("Daftar bab berubah. Muat ulang halaman lalu coba lagi.");
          if (!response.ok) throw new Error("Urutan belum tersimpan. Coba lagi.");
          window.location.reload();
        } catch (cause) {
          if (status) status.textContent = cause instanceof Error ? cause.message : "Urutan belum tersimpan. Coba lagi.";
          const visibleControls = [...document.querySelectorAll<HTMLButtonElement>(".move-chapter")];
          visibleControls.forEach((control) => {
            const chapterIndex = originalIds.indexOf(control.dataset.id ?? "");
            control.disabled = control.dataset.direction === "up" ? chapterIndex <= 0 : chapterIndex >= ids.length - 1;
          });
        }
      }));
      document.querySelector("#save")?.addEventListener("click", async (event) => {
        if (!activeId || !content) return;
        const button = event.currentTarget as HTMLButtonElement;
        const status = document.querySelector<HTMLElement>("#status")!;
        button.disabled = true; status.textContent = "Menyimpan…";
        try {
          const response = await fetch(`${api}/chapters/${activeId}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ content: content.value, expectedCurrentRevisionId: activeRevisionId }) });
          if (response.status === 409) throw new Error("Naskah berubah di sesi lain. Muat ulang halaman sebelum menyimpan lagi.");
          if (!response.ok) throw new Error("Belum tersimpan. Periksa koneksi lalu coba lagi.");
          const result: unknown = await response.json();
          const payload = result as { revisionNumber?: unknown; revisionId?: unknown };
          if (typeof payload.revisionId !== "string") throw new Error("Respons penyimpanan tidak lengkap.");
          activeRevisionId = payload.revisionId;
          const selected = document.querySelector<HTMLButtonElement>(`.chapter[data-id="${activeId}"]`);
          if (selected) {
            selected.dataset.content = content.value;
            selected.dataset.currentRevisionId = payload.revisionId;
            selected.dataset.revisionNumber = String(payload.revisionNumber ?? "");
          }
          savedContent = content.value;
          status.textContent = `Tersimpan sebagai revisi ${typeof payload.revisionNumber === "number" ? payload.revisionNumber : "baru"}.`;
        } catch (cause) { status.textContent = cause instanceof Error ? cause.message : "Belum tersimpan. Periksa koneksi lalu coba lagi."; }
        finally { button.disabled = false; }
      });
      document.querySelector("#show-history")?.addEventListener("click", async () => {
        if (!activeId) return;
        if (content && content.value !== savedContent) {
          document.querySelector<HTMLElement>("#status")!.textContent = "Simpan perubahan sebelum membuka riwayat.";
          return;
        }
        historyModal.hidden = false;
        historyList.replaceChildren();
        preview.hidden = true;
        inspectedRevisionId = null;
        historyStatus.textContent = "Memuat riwayat…";
        try {
          const response = await fetch(`${api}/chapters/${activeId}/revisions`);
          if (!response.ok) throw new Error();
          const result: unknown = await response.json();
          const items = (result as { items?: unknown }).items;
          if (!Array.isArray(items) || items.length === 0) {
            historyStatus.textContent = "Belum ada revisi tersimpan.";
            return;
          }
          historyStatus.textContent = `${items.length} revisi terbaru`;
          for (const raw of items) {
            const revision = raw as { id?: unknown; number?: unknown; source?: unknown; createdAt?: unknown; characterCount?: unknown };
            if (typeof revision.id !== "string") continue;
            const item = document.createElement("button");
            item.type = "button";
            item.className = "revision-item";
            item.setAttribute("aria-pressed", revision.id === activeRevisionId ? "true" : "false");
            const label = document.createElement("span");
            label.textContent = `Revisi ${String(revision.number ?? "?")}${revision.id === activeRevisionId ? " · Aktif" : ""}`;
            const meta = document.createElement("span");
            meta.className = "revision-meta";
            const date = typeof revision.createdAt === "string" ? new Date(revision.createdAt).toLocaleString("id-ID", { dateStyle: "medium", timeStyle: "short" }) : "";
            const sourceLabel = revision.source === "restore" ? "Pemulihan" : revision.source === "ai_suggestion" ? "Usulan AI" : revision.source === "import" ? "Impor" : "Manual";
            meta.textContent = `${sourceLabel} · ${date} · ${Number(revision.characterCount ?? 0).toLocaleString("id-ID")} karakter`;
            item.appendChild(label);
            item.appendChild(meta);
            item.addEventListener("click", async () => {
              historyList.querySelectorAll("button").forEach((entry) => entry.setAttribute("aria-pressed", "false"));
              item.setAttribute("aria-pressed", "true");
              historyStatus.textContent = "Membuka revisi…";
              try {
                const detailResponse = await fetch(`${api}/chapters/${activeId}/revisions/${revision.id}`);
                if (!detailResponse.ok) throw new Error();
                const detail: unknown = await detailResponse.json();
                const snapshot = detail as { content?: unknown; number?: unknown };
                if (typeof snapshot.content !== "string") throw new Error();
                inspectedRevisionId = revision.id as string;
                previewHeading.textContent = `Pratinjau revisi ${String(snapshot.number ?? "")}`;
                previewContent.textContent = snapshot.content;
                preview.hidden = false;
                historyStatus.textContent = "Pratinjau saja. Naskah aktif belum berubah.";
              } catch { historyStatus.textContent = "Revisi tidak dapat dibuka. Coba muat ulang riwayat."; }
            });
            historyList.appendChild(item);
          }
        } catch { historyStatus.textContent = "Riwayat belum dapat dimuat. Coba lagi."; }
      });
      document.querySelector("#restore-revision")?.addEventListener("click", async () => {
        if (!activeId || !inspectedRevisionId) return;
        if (!window.confirm("Pulihkan isi revisi ini? Arenka akan membuat revisi baru dan mempertahankan seluruh riwayat.")) return;
        const button = document.querySelector<HTMLButtonElement>("#restore-revision")!;
        button.disabled = true;
        historyStatus.textContent = "Membuat revisi pemulihan…";
        try {
          const response = await fetch(`${api}/chapters/${activeId}/revisions/${inspectedRevisionId}`, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ expectedCurrentRevisionId: activeRevisionId }),
          });
          if (response.status === 409) throw new Error("Naskah aktif berubah. Tutup riwayat dan muat ulang halaman.");
          if (!response.ok) throw new Error("Pemulihan gagal. Coba lagi.");
          historyStatus.textContent = "Revisi dipulihkan. Memuat naskah terbaru…";
          window.location.reload();
        } catch (cause) {
          historyStatus.textContent = cause instanceof Error ? cause.message : "Pemulihan gagal. Coba lagi.";
          button.disabled = false;
        }
      });
      document.querySelector("#close-history")?.addEventListener("click", () => { historyModal.hidden = true; });
      function openDialog() { modal.hidden = false; (document.querySelector<HTMLInputElement>("#new-title"))?.focus(); }
      document.querySelector("#new-chapter")?.addEventListener("click", openDialog);
      document.querySelector("#first-chapter")?.addEventListener("click", openDialog);
      document.querySelector("#cancel")?.addEventListener("click", () => { modal.hidden = true; });
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submit = form.querySelector<HTMLButtonElement>("[type=submit]")!;
        submit.disabled = true; error.textContent = "Membuat bab…";
        try {
          const response = await fetch(`${api}/chapters`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ title: (document.querySelector<HTMLInputElement>("#new-title"))!.value, purpose: (document.querySelector<HTMLTextAreaElement>("#new-purpose"))!.value }) });
          if (!response.ok) throw new Error();
          window.location.reload();
        } catch { error.textContent = "Bab belum dibuat. Periksa isian dan coba lagi."; submit.disabled = false; }
      });
    </script>
  </body>
</html>



