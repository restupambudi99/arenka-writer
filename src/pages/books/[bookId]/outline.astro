---
import { env } from "cloudflare:workers";
import { authenticatedOwner, validId } from "../../../lib/api";
import type { Env } from "../../../env";
export const prerender = false;
const ownerId = authenticatedOwner(Astro.locals);
if (!ownerId) return Astro.redirect("/_emdash/admin");
const bookId = Astro.params.bookId ?? "";
if (!validId(bookId)) return Astro.redirect("/");
const db = (env as Env).DB;
const book = await db.prepare("SELECT id, title, summary, kind, target_word_count, wizard_json FROM books WHERE id = ? AND owner_id = ? LIMIT 1").bind(bookId, ownerId).first<{ id: string; title: string; summary: string; kind: string; target_word_count: number; wizard_json: string }>();
if (!book) return Astro.redirect("/");
let wizard: Record<string, Record<string, string>> = {};
try { wizard = JSON.parse(book.wizard_json) as Record<string, Record<string, string>>; } catch { wizard = {}; }
const latest = await db.prepare("SELECT version, outline_json FROM book_outlines WHERE book_id = ? AND owner_id = ? ORDER BY version DESC LIMIT 1").bind(bookId, ownerId).first<{ version: number; outline_json: string }>();
let outline: Array<{ id: string; title: string; purpose: string; sections: Array<{ title: string; purpose: string }> }> = [];
try { if (latest) outline = JSON.parse(latest.outline_json) as typeof outline; } catch { outline = []; }
const version = latest?.version ?? 0;
---
<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Outline · {book.title} · Arenka Writer</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#242720;background:#f7f5f0}*{box-sizing:border-box}body{margin:0}.bar{height:62px;padding:0 22px;border-bottom:1px solid #e6e3dc;background:#fbfaf7;display:flex;align-items:center;gap:18px}.bar a{color:#526b57;text-decoration:none;font-size:13px}.book-title{font:500 18px Georgia,serif;color:#272a24}.stage{margin-left:auto;color:#536b58;background:#edf2eb;padding:7px 10px;border-radius:999px;font-size:11px}.wrap{width:min(880px,100%);margin:auto;padding:35px 22px 80px}.eyebrow{color:#81837b;font-size:11px;font-weight:650;letter-spacing:.09em;text-transform:uppercase}h1{font:500 clamp(33px,5vw,44px)/1.1 Georgia,serif;letter-spacing:-.04em;margin:12px 0}.intro{color:#74766f;line-height:1.6;font-size:14px;max-width:660px}.summary{margin:22px 0;padding:16px 18px;background:#eeefe9;border-radius:11px;color:#55584f;font-size:13px;line-height:1.6}.toolbar{display:flex;gap:9px;align-items:center;margin:22px 0}.button{border:1px solid #deddd5;border-radius:9px;background:white;color:#42463e;padding:10px 14px;font:600 12px Inter,system-ui,sans-serif;cursor:pointer}.primary{background:#294b3b;border-color:#294b3b;color:white}.button:disabled{opacity:.55;cursor:wait}.status{font-size:12px;color:#73766d;min-height:19px}.chapter{background:#fff;border:1px solid #e5e2da;border-radius:12px;padding:17px;margin:12px 0}.chapter-head{display:flex;gap:10px;align-items:center}.index{font:15px Georgia,serif;color:#8a8c82;min-width:26px}.chapter input,.chapter textarea,.section input,.section textarea{width:100%;border:1px solid #e2e0d8;border-radius:8px;padding:10px 11px;font:14px Inter,system-ui,sans-serif;color:#292c26}.chapter textarea,.section textarea{margin-top:9px;resize:vertical;min-height:54px}.chapter-actions{display:flex;gap:6px;margin-left:auto}.icon{border:1px solid #e4e2da;border-radius:7px;background:white;width:31px;height:31px;color:#53574e;cursor:pointer}.sections{margin:12px 0 0 38px;padding-left:15px;border-left:2px solid #ebebe5}.section{display:flex;gap:8px;margin:9px 0;align-items:flex-start}.section-fields{flex:1}.section input{height:38px}.remove{border:0;background:transparent;color:#9b554c;cursor:pointer;padding:9px}.chapter-bottom{margin:12px 0 0 38px;display:flex;gap:8px}.empty{padding:30px;text-align:center;background:#fff;border:1px dashed #d8d7ce;border-radius:12px;color:#74766f}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:600px){.wrap{padding:26px 15px}.bar{gap:10px;padding:0 12px}.book-title{max-width:36vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.toolbar{flex-wrap:wrap}.sections,.chapter-bottom{margin-left:10px}}
</style></head><body data-book-id={bookId} data-version={version} data-kind={book.kind} data-genre={wizard.dna?.genre ?? ""} data-target={book.target_word_count}>
<header class="bar"><a href={`/books/${bookId}`}>← Workspace</a><span class="book-title">{book.title}</span><a class="stage" href={`/books/new?bookId=${bookId}&step=4`}>Blueprint</a><span class="stage">Outline</span><a class="stage" href={`/books/${bookId}/preview`}>Preview</a></header><main class="wrap"><p class="eyebrow">Tahap 2 · Kerangka buku</p><h1>Susun perjalanan buku.</h1><p class="intro">Bagi gagasan utama menjadi bab dan bagian. Anda dapat mengubah urutan dan menyimpan versi outline kapan saja.</p><div class="summary"><strong>{wizard.dna?.genre ?? (book.kind === "fiction" ? "Fiksi" : "Nonfiksi")}</strong><br/>{book.summary || wizard.dna?.premise || "Blueprint belum memiliki ringkasan. Kerangka tetap dapat disusun."}<br/>Target sekitar {book.target_word_count.toLocaleString("id-ID")} kata.</div><div class="toolbar"><button class="button primary" id="save" type="button">Simpan outline</button><button class="button" id="add-chapter" type="button">＋ Tambah bab</button><button class="button" id="suggest" type="button">Buat kerangka awal</button><span class="status" id="status" role="status" aria-live="polite">Versi {version} tersimpan</span></div><div id="chapters">{outline.map((chapter,index)=><article class="chapter" data-chapter-id={chapter.id}><div class="chapter-head"><span class="index">{String(index+1).padStart(2,"0")}</span><label class="sr" for={`chapter-title-${index}`}>Judul bab</label><input id={`chapter-title-${index}`} class="chapter-title" maxlength="200" value={chapter.title}/><div class="chapter-actions"><button class="icon move" data-direction="up" aria-label="Pindahkan bab ke atas" type="button">↑</button><button class="icon move" data-direction="down" aria-label="Pindahkan bab ke bawah" type="button">↓</button><button class="remove" type="button">Hapus</button></div></div><label class="sr" for={`chapter-purpose-${index}`}>Tujuan bab</label><textarea id={`chapter-purpose-${index}`} class="chapter-purpose" maxlength="2000" placeholder="Apa yang berubah atau dibahas dalam bab ini?">{chapter.purpose}</textarea><div class="sections">{chapter.sections.map((section,sectionIndex)=><div class="section"><div class="section-fields"><label class="sr" for={`section-title-${index}-${sectionIndex}`}>Judul bagian</label><input id={`section-title-${index}-${sectionIndex}`} class="section-title" maxlength="200" value={section.title}/><label class="sr" for={`section-purpose-${index}-${sectionIndex}`}>Isi bagian</label><textarea id={`section-purpose-${index}-${sectionIndex}`} class="section-purpose" maxlength="1000">{section.purpose}</textarea></div><button class="remove" type="button">Hapus bagian</button></div>)}</div><div class="chapter-bottom"><button class="button add-section" type="button">＋ Tambah bagian</button></div></article>)}</div><div class="empty" id="empty" hidden>Belum ada bab dalam outline. Tambahkan bab untuk mulai menyusun kerangka.</div><div class="toolbar"><button class="button primary" id="save-bottom" type="button">Simpan outline</button><a class="button" href={`/books/${bookId}`}>Lanjut ke naskah →</a></div></main>
<script>
const bookId=document.body.dataset.bookId!;const container=document.querySelector<HTMLElement>("#chapters")!;const status=document.querySelector<HTMLElement>("#status")!;const empty=document.querySelector<HTMLElement>("#empty")!;let version=Number(document.body.dataset.version??0);let saved="";
function readOutline(){return [...container.querySelectorAll<HTMLElement>(".chapter")].map(chapter=>({id:chapter.dataset.chapterId??crypto.randomUUID(),title:chapter.querySelector<HTMLInputElement>(".chapter-title")?.value.trim()??"",purpose:chapter.querySelector<HTMLTextAreaElement>(".chapter-purpose")?.value.trim()??"",sections:[...chapter.querySelectorAll<HTMLElement>(".section")].map(section=>({title:section.querySelector<HTMLInputElement>(".section-title")?.value.trim()??"",purpose:section.querySelector<HTMLTextAreaElement>(".section-purpose")?.value.trim()??""}))}));}saved=JSON.stringify(readOutline());
function refresh(){empty.hidden=container.children.length>0;[...container.querySelectorAll<HTMLElement>(".chapter")].forEach((chapter,index)=>{const number=chapter.querySelector<HTMLElement>(".index");if(number)number.textContent=String(index+1).padStart(2,"0");const up=chapter.querySelector<HTMLButtonElement>('[data-direction="up"]');const down=chapter.querySelector<HTMLButtonElement>('[data-direction="down"]');if(up)up.disabled=index===0;if(down)down.disabled=index===container.children.length-1;});}
function addSection(chapter:HTMLElement){const row=document.createElement("div");row.className="section";row.innerHTML='<div class="section-fields"><input class="section-title" maxlength="200" aria-label="Judul bagian" placeholder="Judul bagian"/><textarea class="section-purpose" maxlength="1000" aria-label="Catatan bagian" placeholder="Catatan bagian"></textarea></div><button class="remove" type="button">Hapus bagian</button>';chapter.querySelector(".sections")?.insertAdjacentHTML("beforeend",row.outerHTML);const inserted=chapter.querySelector(".section:last-child");inserted?.querySelector(".remove")?.addEventListener("click",()=>inserted.remove());inserted?.querySelector<HTMLInputElement>("input")?.focus();}
function bind(chapter:HTMLElement){chapter.querySelector(".remove")?.addEventListener("click",()=>{chapter.remove();refresh();});chapter.querySelector(".add-section")?.addEventListener("click",()=>addSection(chapter));chapter.querySelectorAll<HTMLButtonElement>(".move").forEach(button=>button.addEventListener("click",()=>{const siblings=[...container.children];const index=siblings.indexOf(chapter);if(button.dataset.direction==="up"&&index>0)container.insertBefore(chapter,siblings[index-1]!);if(button.dataset.direction==="down"&&index<siblings.length-1)container.insertBefore(siblings[index+1]!,chapter);refresh();}));chapter.querySelectorAll(".section .remove").forEach(button=>button.addEventListener("click",()=>{button.closest(".section")?.remove();}));}
function addChapter(title="",purpose=""){const chapter=document.createElement("article");chapter.className="chapter";chapter.dataset.chapterId=crypto.randomUUID();chapter.innerHTML='<div class="chapter-head"><span class="index"></span><input class="chapter-title" maxlength="200" aria-label="Judul bab" placeholder="Judul bab"/><div class="chapter-actions"><button class="icon move" data-direction="up" aria-label="Pindahkan bab ke atas" type="button">↑</button><button class="icon move" data-direction="down" aria-label="Pindahkan bab ke bawah" type="button">↓</button><button class="remove" type="button">Hapus</button></div></div><textarea class="chapter-purpose" maxlength="2000" aria-label="Tujuan bab" placeholder="Tujuan bab"></textarea><div class="sections"></div><div class="chapter-bottom"><button class="button add-section" type="button">＋ Tambah bagian</button></div>';chapter.querySelector<HTMLInputElement>(".chapter-title")!.value=title;chapter.querySelector<HTMLTextAreaElement>(".chapter-purpose")!.value=purpose;container.insertAdjacentHTML("beforeend",chapter.outerHTML);const inserted=container.lastElementChild as HTMLElement;bind(inserted);refresh();inserted.querySelector<HTMLInputElement>(".chapter-title")?.focus();}
container.querySelectorAll<HTMLElement>(".chapter").forEach(bind);refresh();document.querySelector("#add-chapter")?.addEventListener("click",()=>addChapter());
async function save(){const outline=readOutline();if(!outline.length||outline.some(chapter=>!chapter.title)||outline.some(chapter=>chapter.sections.some(section=>!section.title))){status.textContent="Isi judul setiap bab dan bagian, atau hapus bagian yang kosong.";return;}const buttons=[...document.querySelectorAll<HTMLButtonElement>("#save,#save-bottom")];buttons.forEach(button=>button.disabled=true);status.textContent="Menyimpan versi outline…";try{const response=await fetch(`/api/books/${bookId}/outline`,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({expectedVersion:version,outline})});if(response.status===409)throw new Error("Outline berubah di sesi lain. Muat ulang untuk mengambil versi terbaru.");if(!response.ok)throw new Error("Outline belum tersimpan. Periksa isian dan coba lagi.");const result=await response.json() as {version?:number};version=result.version??version+1;saved=JSON.stringify(outline);status.textContent=`Versi ${version} tersimpan.`;}catch(error){status.textContent=error instanceof Error?error.message:"Outline belum tersimpan.";}finally{buttons.forEach(button=>button.disabled=false);}}
document.querySelectorAll("#save,#save-bottom").forEach(button=>button.addEventListener("click",save));
document.querySelector("#suggest")?.addEventListener("click",()=>{if(container.children.length&&!confirm("Ganti outline yang sedang Anda susun dengan kerangka contoh?"))return;container.replaceChildren();const fiction=document.body.dataset.kind==="fiction";const genre=document.body.dataset.genre||"buku";const ideas=fiction?["Dunia dan tokoh utama","Pemicu masalah","Pilihan dan konsekuensi","Titik balik","Penyelesaian"]:["Konteks dan masalah","Gagasan utama","Bukti atau pengalaman","Penerapan","Kesimpulan dan langkah lanjut"];ideas.forEach((title,index)=>addChapter(`${String(index+1).padStart(2,"0")} · ${title}`,index===0?`Perkenalkan ${genre} serta konteks yang perlu diketahui pembaca.`:"Kembangkan satu tahap penting menuju gagasan utama buku."));status.textContent="Kerangka awal dibuat secara lokal; tinjau dan sesuaikan sebelum menyimpan.";});
window.addEventListener("beforeunload",event=>{if(JSON.stringify(readOutline())!==saved){event.preventDefault();}});
</script></body></html>


