---
import { env } from "cloudflare:workers";
import { authenticatedOwner, validId } from "../../../lib/api";
import type { Env } from "../../../env";
import type { BookLayout } from "../../../domain";
export const prerender = false;
const ownerId = authenticatedOwner(Astro.locals);
if (!ownerId) return Astro.redirect("/_emdash/admin");
const bookId = Astro.params.bookId ?? "";
if (!validId(bookId)) return Astro.redirect("/");
const db = (env as Env).DB;
const book = await db.prepare("SELECT id,title,summary,layout_json,wizard_json FROM books WHERE id=? AND owner_id=? AND archived_at IS NULL LIMIT 1").bind(bookId, ownerId).first<{id:string;title:string;summary:string;layout_json:string;wizard_json:string}>();
if (!book) return Astro.redirect("/");
const chapterRows = await db.prepare("SELECT c.id,c.title,c.approval_status,COALESCE(approved.content,current.content) AS content FROM chapters c LEFT JOIN chapter_revisions approved ON approved.id=c.approved_revision_id AND approved.chapter_id=c.id AND approved.owner_id=c.owner_id LEFT JOIN chapter_revisions current ON current.id=c.current_revision_id AND current.chapter_id=c.id AND current.owner_id=c.owner_id WHERE c.book_id=? AND c.owner_id=? ORDER BY c.position").bind(bookId, ownerId).all<{id:string;title:string;approval_status:string;content:string|null}>();
const chapters = chapterRows.results;
const layout = JSON.parse(book.layout_json) as BookLayout;
let wizard: Record<string,Record<string,string>> = {};
try { wizard=JSON.parse(book.wizard_json) as Record<string,Record<string,string>>; } catch { wizard={}; }
const approvedCount = chapters.filter((chapter)=>chapter.approval_status==="approved").length;
const canExport = chapters.length>0 && approvedCount===chapters.length && chapters.some((chapter)=>Boolean(chapter.content?.trim()));

---
<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Preview & unduh · {book.title} · Arenka Writer</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#242720;background:#f7f5f0}*{box-sizing:border-box}body{margin:0}.bar{height:62px;padding:0 22px;border-bottom:1px solid #e6e3dc;background:#fbfaf7;display:flex;align-items:center;gap:17px}.bar a{color:#526b57;text-decoration:none;font-size:13px}.book-title{font:500 18px Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stage{margin-left:auto;background:#edf2eb;color:#536b58;padding:7px 10px;border-radius:999px;font-size:11px}.wrap{width:min(1120px,100%);margin:auto;padding:32px 22px 70px}.intro{color:#74766f;font-size:13px;line-height:1.6}h1{font:500 35px Georgia,serif;margin:6px 0}.layout{display:grid;grid-template-columns:minmax(0,1fr) 275px;gap:24px;align-items:start;margin-top:23px}.paper-stack{display:grid;gap:20px;justify-items:center}.paper{width:min(100%,595px);min-height:720px;background:#fff;border:1px solid #e5e2da;box-shadow:0 7px 25px #302a170d;padding:65px 58px;color:#292b25}.paper.cover{display:flex;flex-direction:column;justify-content:center;text-align:center;min-height:760px}.paper h2{font:500 27px Georgia,serif;margin:0 0 18px}.paper h3{font:500 21px Georgia,serif;margin:0 0 20px}.paper p{font:15px/1.8 Georgia,serif;white-space:pre-wrap;overflow-wrap:anywhere}.paper .author{margin-top:90px}.paper .cover-sub{color:#71736c}.paper li{font:14px/1.8 Georgia,serif;margin:6px 0}.side{background:#fff;border:1px solid #e5e2da;border-radius:12px;padding:18px;position:sticky;top:18px}.side h2{font:500 20px Georgia,serif;margin:0 0 14px}.side label{display:block;font-size:12px;font-weight:600;margin:13px 0 6px}.side input,.side select{width:100%;height:40px;border:1px solid #deddd5;border-radius:8px;padding:0 10px;font:13px Inter,system-ui,sans-serif}.checklist{margin:18px 0;padding:0;list-style:none;display:grid;gap:9px}.checklist li{font-size:12px;color:#686b62}.ok{color:#476b4e}.pending{color:#9a6544}.button{width:100%;border:0;border-radius:9px;background:#294b3b;color:white;padding:12px 14px;font:600 13px Inter,system-ui,sans-serif;cursor:pointer}.button:disabled{opacity:.5;cursor:not-allowed}.status{min-height:36px;color:#73766d;font-size:12px;line-height:1.5}.notice{color:#76796f;font-size:11px;line-height:1.5;margin:13px 0 0}.page-number{text-align:center;color:#8b8d84;font:11px Georgia,serif;margin-top:auto}.empty{background:#fff;padding:28px;border:1px dashed #d9d7cf;border-radius:12px;text-align:center;color:#70736b}@media(max-width:800px){.layout{grid-template-columns:1fr}.side{position:static;grid-row:1}.paper{min-height:620px;padding:45px 30px}.paper.cover{min-height:650px}.bar{padding:0 12px;gap:9px}.book-title{max-width:32vw}}
</style></head><body data-book-id={bookId}>
<header class="bar"><a href={`/books/${bookId}`}>← Workspace</a><span class="book-title">{book.title}</span><a class="stage" href={`/books/${bookId}/outline`}>Outline</a><span class="stage">Preview & unduh</span></header>
<main class="wrap"><p class="intro">Pratinjau memakai snapshot revisi yang disetujui. Review dan ekspor merupakan langkah terpisah.</p><h1>{wizard.cover?.title || book.title}</h1><div class="layout"><div class="paper-stack" id="preview">
<section class="paper cover"><h2>{wizard.cover?.title || book.title}</h2><p class="cover-sub">{wizard.cover?.subtitle || ""}</p><p class="author">{wizard.cover?.author || "Nama penulis"}</p></section><section class="paper"><h3>Daftar Isi</h3><ol>{chapters.filter((chapter)=>chapter.approval_status==="approved").map((chapter)=><li>{chapter.title}</li>)}</ol></section>
{chapters.map((chapter,index)=><article class="paper" data-chapter-id={chapter.id} data-approval={chapter.approval_status} data-page-size={layout.pageSize} data-orientation={layout.orientation} aria-label={`Pratinjau bab ${index+1}: ${chapter.title}`}><h3>{chapter.title}</h3><p>{chapter.content || "Bab ini belum memiliki isi."}</p><div class="page-number">{layout.pageNumberStyle==="none"?"":String(index+3)}</div><p class="chapter-state">{chapter.approval_status==="approved"?"Revisi aktif disetujui.":"Belum disetujui."}</p><button class="chapter-approve" type="button">{chapter.approval_status==="approved"?"Batalkan persetujuan":"Setujui revisi"}</button></article>)}
{!chapters.length&&<div class="empty">Tambahkan bab dan revisi di workspace untuk melihat preview.</div>}
</div><aside class="side"><h2>Daftar periksa</h2><p class="intro">{approvedCount} dari {chapters.length} bab disetujui.</p><ul class="checklist"><li class={wizard.cover?.author?"ok":"pending"}>{wizard.cover?.author?"✓":"○"} Nama penulis pada sampul</li><li class={chapters.length?"ok":"pending"}>{chapters.length?"✓":"○"} Buku memiliki bab</li><li class={approvedCount===chapters.length&&chapters.length?"ok":"pending"}>{approvedCount===chapters.length&&chapters.length?"✓":"○"} Semua bab disetujui</li><li class={chapters.some((chapter)=>Boolean(chapter.content?.trim()))?"ok":"pending"}>{chapters.some((chapter)=>Boolean(chapter.content?.trim()))?"✓":"○"} Ada isi naskah</li></ul><p class="notice">Buka dan tinjau setiap bab, lalu setujui revisinya satu per satu. Perubahan naskah membatalkan persetujuan yang lama.</p><p class="status" id="status" role="status" aria-live="polite">{canExport?"Tinjau bab, setujui, lalu unduh.":"Lengkapi isi bab sebelum ekspor."}</p><button class="button" id="export" disabled={!canExport}>Unduh PDF</button></aside></div></main>
<script>
const bookId=document.body.dataset.bookId!;const status=document.querySelector<HTMLElement>("#status")!;const exportButton=document.querySelector<HTMLButtonElement>("#export")!;const chapters=[...document.querySelectorAll<HTMLElement>(".paper-stack article[data-chapter-id]")];
function updateExport(){const allApproved=chapters.length>0&&chapters.every(chapter=>chapter.dataset.approval==="approved");const hasContent=chapters.some(chapter=>Boolean(chapter.querySelector("p")?.textContent?.trim()));exportButton.disabled=!allApproved||!hasContent;const count=chapters.filter(chapter=>chapter.dataset.approval==="approved").length;status.textContent=allApproved?"Semua revisi aktif disetujui. PDF siap diunduh.":`${count} dari ${chapters.length} bab disetujui.`;}
document.querySelectorAll<HTMLButtonElement>(".chapter-approve").forEach(button=>button.addEventListener("click",async()=>{const chapter=button.closest<HTMLElement>("[data-chapter-id]");if(!chapter)return;button.disabled=true;status.textContent="Menyimpan persetujuan revisi…";try{const next=chapter.dataset.approval==="approved"?"draft":"approved";const response=await fetch(`/api/books/${bookId}/chapters/${chapter.dataset.chapterId}/approval`,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:next})});if(!response.ok)throw new Error(response.status===409?"Revisi aktif berubah. Muat ulang preview dan tinjau ulang bab.":"Persetujuan belum tersimpan.");chapter.dataset.approval=next;button.textContent=next==="approved"?"Batalkan persetujuan":"Setujui revisi";chapter.querySelector<HTMLElement>(".chapter-state")!.textContent=next==="approved"?"Revisi aktif disetujui.":"Belum disetujui.";updateExport();}catch(error){status.textContent=error instanceof Error?error.message:"Persetujuan belum tersimpan.";}finally{button.disabled=false;}}));updateExport();exportButton.addEventListener("click",async()=>{if(exportButton.disabled){status.textContent="Setujui semua revisi sebelum ekspor.";return;}exportButton.disabled=true;status.textContent="Membuat dan menyimpan PDF…";try{const response=await fetch(`/api/books/${bookId}/export`,{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});if(!response.ok){const result=await response.json().catch(()=>({})) as {error?:string};throw new Error(result.error==="chapters_require_approval"?"Ada bab yang belum disetujui.":"PDF belum dapat dibuat. Periksa binding R2 dan coba lagi.");}const blob=await response.blob();const url=URL.createObjectURL(blob);const anchor=document.createElement("a");anchor.href=url;anchor.download="arenka-book.pdf";document.body.appendChild(anchor);anchor.click();anchor.remove();URL.revokeObjectURL(url);status.textContent="PDF selesai dibuat dan disimpan di R2.";}catch(error){status.textContent=error instanceof Error?error.message:"Ekspor gagal.";}finally{updateExport();}});
</script></body></html>









