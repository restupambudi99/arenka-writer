---
import { authenticatedOwner } from "../../lib/api";
export const prerender = false;
if (!authenticatedOwner(Astro.locals)) return Astro.redirect("/_emdash/admin");
---
<!doctype html>
<html lang="id">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Profil Suara · Arenka Writer</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#242720;background:#f7f5f0}*{box-sizing:border-box}body{margin:0}.wrap{width:min(650px,100%);margin:auto;padding:38px 22px}.back{color:#526b57;text-decoration:none;font-size:13px}.eyebrow{margin:38px 0 8px;color:#81837b;font-size:12px;text-transform:uppercase;letter-spacing:.09em;font-weight:650}h1{font:500 clamp(34px,6vw,46px)/1.1 Georgia,serif;letter-spacing:-.04em;margin:0 0 10px}.intro{color:#74766f;font-size:14px;line-height:1.6;margin:0 0 28px}.panel{background:#fff;border:1px solid #e6e3dc;border-radius:15px;padding:24px}.field{display:grid;gap:8px;margin-bottom:20px}.field label{font-size:13px;font-weight:620}.field input,.field textarea{width:100%;border:1px solid #deddd5;border-radius:9px;padding:12px;font:inherit;font-size:14px}.field textarea{min-height:150px;line-height:1.6;resize:vertical}.field input:focus,.field textarea:focus{outline:3px solid #dce8dc;border-color:#719078}.note{padding:12px;border-radius:9px;background:#f4f4ef;color:#77796f;font-size:12px;line-height:1.55;margin-bottom:20px}.button{border:0;border-radius:9px;background:#294b3b;color:#fff;padding:12px 17px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer}.button:disabled{opacity:.55}.error{min-height:20px;color:#a53e35;font-size:13px}
    </style>
  </head>
  <body><main class="wrap"><a class="back" href="/books/new">← Kembali ke pembuatan buku</a><p class="eyebrow">Profil Suara</p><h1>Bagaimana suara tulisan Anda?</h1><p class="intro">Tulis beberapa petunjuk agar Anda dapat memilih suara ini saat memulai buku. Profil dapat dikembangkan nanti.</p>
    <form class="panel" id="profile-form"><div class="field"><label for="name">Nama profil</label><input id="name" maxlength="100" required placeholder="Contoh: Esai yang hangat"/></div><div class="field"><label for="description">Ciri tulisan</label><textarea id="description" maxlength="5000" required placeholder="Ceritakan pilihan kata, ritme, sudut pandang, dan hal yang ingin dihindari…"></textarea></div><div class="note">Deskripsi ini disimpan untuk membantu mengatur tulisan buku Anda. Belum ada data yang dikirim ke AI.</div><button class="button" type="submit">Simpan profil</button><p class="error" id="error" role="status" aria-live="polite"></p></form></main>
    <script>
      const form = document.querySelector<HTMLFormElement>("#profile-form")!;
      const error = document.querySelector<HTMLElement>("#error")!;
      const button = form.querySelector<HTMLButtonElement>("button")!;
      form.addEventListener("submit", async (event) => {
        event.preventDefault(); button.disabled = true; error.textContent = "Menyimpan profil…";
        try {
          const response = await fetch("/api/voice-profiles", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: (document.querySelector<HTMLInputElement>("#name"))!.value, description: (document.querySelector<HTMLTextAreaElement>("#description"))!.value }) });
          if (!response.ok) throw new Error();
          window.location.assign("/books/new");
        } catch { error.textContent = "Profil belum tersimpan. Periksa isian dan coba lagi."; button.disabled = false; }
      });
    </script>
  </body>
</html>


