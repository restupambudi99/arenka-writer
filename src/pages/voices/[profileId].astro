---
import { env } from "cloudflare:workers";
import { authenticatedOwner } from "../../lib/api";
import type { Env } from "../../env";

export const prerender = false;
const ownerId = authenticatedOwner(Astro.locals);
if (!ownerId) return Astro.redirect("/_emdash/admin");
const profileId = Astro.params.profileId ?? "";
const db = (env as Env).DB;
const latest = await db.prepare("SELECT MAX(version) AS version FROM voice_profiles WHERE id = ? AND owner_id = ?")
  .bind(profileId, ownerId).first<{ version: number | null }>();
if (!latest?.version) return Astro.redirect("/voices");
const selectedVersion = Astro.url.searchParams.has("version") ? Number(Astro.url.searchParams.get("version")) : latest.version;
if (!Number.isInteger(selectedVersion) || selectedVersion < 1 || selectedVersion > latest.version) return Astro.redirect("/voices");
const profile = await db.prepare("SELECT version, name, status, profile_json, created_at FROM voice_profiles WHERE id = ? AND owner_id = ? AND version = ?")
  .bind(profileId, ownerId, selectedVersion).first<{ version: number; name: string; status: string; profile_json: string; created_at: string }>();
if (!profile) return Astro.redirect("/voices");
let description = "";
try {
  const data: unknown = JSON.parse(profile.profile_json);
  if (data && typeof data === "object" && "description" in data && typeof data.description === "string") description = data.description;
} catch { /* malformed legacy data can be replaced by saving a new version */ }
const versions = await db.prepare(
  `SELECT p.version, p.status, p.created_at,
    (SELECT COUNT(*) FROM books b WHERE b.voice_profile_id = p.id AND b.voice_profile_version = p.version AND b.owner_id = p.owner_id) AS book_count
   FROM voice_profiles p WHERE p.id = ? AND p.owner_id = ? ORDER BY p.version DESC LIMIT 100`,
).bind(profileId, ownerId).all<{ version: number; status: string; created_at: string; book_count: number }>();
const isLatest = selectedVersion === latest.version && profile.status === "ready";
---
<!doctype html>
<html lang="id">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{profile.name} · Profil Suara</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#242720;background:#f7f5f0}*{box-sizing:border-box}body{margin:0}.shell{width:min(960px,100%);margin:auto;padding:35px 22px 70px}.back{color:#526b57;text-decoration:none;font-size:13px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 245px;gap:20px;margin-top:38px}h1{font:500 clamp(32px,5vw,43px)/1.1 Georgia,serif;letter-spacing:-.04em;margin:0 0 9px}.sub{font-size:13px;line-height:1.6;color:#77796f;margin:0 0 22px}.panel,.history{padding:22px;border:1px solid #e6e3dc;border-radius:14px;background:#fff}.field{display:grid;gap:8px;margin-bottom:20px}.field label{font-size:13px;font-weight:620}.field input,.field textarea{width:100%;border:1px solid #deddd5;border-radius:9px;padding:12px;font:inherit;font-size:14px;color:#252821}.field textarea{min-height:220px;line-height:1.6;resize:vertical}.field input:focus,.field textarea:focus{outline:3px solid #dce8dc;border-color:#719078}.field input:disabled,.field textarea:disabled{background:#f6f5f1;color:#62645d}.button{border:0;border-radius:9px;background:#294b3b;color:#fff;padding:12px 16px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer}.button:disabled{opacity:.55}.note{padding:12px;border-radius:9px;background:#f4f4ef;color:#77796f;font-size:12px;line-height:1.55;margin-bottom:18px}.history h2{font:500 20px Georgia,serif;margin:0 0 13px}.version{display:block;padding:11px 10px;border-radius:8px;text-decoration:none;color:#55574f;font-size:12px}.version:hover,.version[aria-current=page]{background:#edf2eb;color:#294b3b}.version small{display:block;color:#85867e;margin-top:5px}.error{min-height:21px;color:#a53e35;font-size:13px}.status{font-size:12px;color:#537057}.create{display:inline-block;margin-top:18px;color:#4d694f;font-size:13px;text-decoration:none}@media(max-width:700px){.layout{grid-template-columns:1fr}.history{grid-row:1}.versions{display:flex;overflow:auto;gap:5px}.version{flex:0 0 auto}.version small{white-space:nowrap}}
    </style>
  </head>
  <body><main class="shell"><a class="back" href="/voices">← Semua profil suara</a><div class="layout"><section><h1>{profile.name}</h1><p class="sub">Versi {profile.version} · {isLatest ? "Versi aktif" : "Versi terdahulu, hanya baca"}</p>
    <form class="panel" id="profile-form"><div class="field"><label for="name">Nama profil</label><input id="name" maxlength="100" required value={profile.name} disabled={!isLatest}/></div><div class="field"><label for="description">Ciri tulisan</label><textarea id="description" maxlength="5000" required disabled={!isLatest}>{description}</textarea></div>
    {isLatest ? <div class="note">Simpan perubahan membuat versi baru. Buku yang sudah memakai versi lama tetap mencatat profil versi tersebut.</div> : <div class="note">Versi ini tidak dapat diubah. Buka versi terbaru untuk melanjutkan penyuntingan.</div>}
    {isLatest && <button class="button" type="submit">Simpan sebagai versi baru</button>}<p class="error" id="error" role="status" aria-live="polite"></p><p class="status" id="status" role="status" aria-live="polite"></p></form><a class="create" href="/voices/new">＋ Buat profil suara lain</a></section>
    <aside class="history"><h2>Riwayat versi</h2><div class="versions">{versions.results.map((version)=><a class="version" href={`/voices/${profileId}?version=${version.version}`} aria-current={version.version === selectedVersion ? "page" : undefined}>Versi {version.version} · {version.status === "ready" ? "Aktif" : version.status}<small>{version.book_count} buku · {new Date(version.created_at).toLocaleDateString("id-ID",{day:"numeric",month:"short",year:"numeric"})}</small></a>)}</div></aside>
  </div></main>
  {isLatest && <script define:vars={{ profileId, expectedVersion: latest.version }}>
    const form = document.querySelector("#profile-form");
    const button = form.querySelector("button[type=submit]");
    const error = document.querySelector("#error");
    const status = document.querySelector("#status");
    form.addEventListener("submit", async (event) => {
      event.preventDefault(); button.disabled = true; status.textContent = "Menyimpan versi baru…";
      try {
        const response = await fetch(`/api/voice-profiles/${profileId}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ expectedVersion, name: document.querySelector("#name").value, description: document.querySelector("#description").value }) });
        if (response.status === 409) throw new Error("Profil berubah di sesi lain. Muat ulang halaman sebelum mencoba lagi.");
        if (!response.ok) throw new Error("Profil belum tersimpan. Periksa isian lalu coba lagi.");
        const result = await response.json();
        window.location.assign(`/voices/${profileId}?version=${result.profile.version}`);
      } catch (cause) { error.textContent = cause instanceof Error ? cause.message : "Profil belum tersimpan."; status.textContent = ""; button.disabled = false; }
    });
  </script>}
  </body>
</html>

