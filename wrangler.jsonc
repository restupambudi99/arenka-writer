{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arenka-writer",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "AI_BASE_URL": "https://9routers.vpsarenka.site/v1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arenka-writer",
      "database_id": "47288a45-2c32-40f7-b260-ba53146f65fc",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "7de5d82ed9d44a08991ddd17ec7c71e0" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "arenka-writer-media" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }]
  },
  "exports": {
    "EmDashRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "routes": [
    { "pattern": "writer.arenka.biz.id", "custom_domain": true }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "secrets": { "required": ["AI_API_KEY", "AI_MODEL"] }
}


